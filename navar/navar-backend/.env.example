# Keep secrets in .env, never in frontend variables or source control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:5173
MALL_ADMIN_ORIGIN=http://localhost:5174

# Existing account invitation/password-reset sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NavAR

# Optional separate inquiry/subscription sender. Leave unset to use SMTP_* above.
# When switching to navarcebu@gmail.com, set its user AND app password together.
OFFICIAL_SMTP_USER=
OFFICIAL_SMTP_PASS=
OFFICIAL_SMTP_FROM=
OFFICIAL_SMTP_FROM_NAME=NavAR

# PayMongo sandbox: no live charging is enabled by this bridge.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Run subscription expiry/grace checks and the durable email queue.
# The backend must stay running. Duplicate events are prevented in the database.
SUBSCRIPTION_REMINDERS_ENABLED=true
# Default: 900000 (15 minutes). For local testing, use 60000 (1 minute).
SUBSCRIPTION_WORKER_INTERVAL_MS=900000
